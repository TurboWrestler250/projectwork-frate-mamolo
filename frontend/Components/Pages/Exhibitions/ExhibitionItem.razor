@if (Item is not null)
{
	<tr>
		<td><img src=@Item.ImageUrl alt="duomo di milano" style="max-width: 150px;"></td>
		<td>@Item.StartDate</td>
		<td>@Item.EndDate</td>
		<td><a href="@($"/exhibitions/details/{Item.Id}")">@Item.Title</a></td>
		<td>@Item.Description</td>
		<td>@Item.Status</td>
		<td>@if(Item.Status=="Active")
			{
				<a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" class="btn btn-xs btn-secondary">Book a visit</a>
			}</td>
	</tr>
}

@code {

	[Parameter]
	public Exhibition? Item { get; set; }

}