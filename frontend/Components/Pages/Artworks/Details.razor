@page "/artworks/details/{id:int}"

@if(_artwork is not null)
{
    <PageTitle>Home / @_artwork.Title</PageTitle>
    <img src="@_artwork.ImageUrl" alt="Alternate Text" style="max-width: 500px">
    <italics><p>@_artwork.Author, @_artwork.Year</p></italics>
    <h1>@_artwork.Title</h1>
    <p>@_artwork.Technique</p>
    <p>@_artwork.Description</p>
}
else
{
    <p>Artwork not found</p>
}

<a href="/artworks" class="btn btn-xs btn-secondary">Back to list</a>