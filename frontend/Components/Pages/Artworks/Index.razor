@page "/artworks"

<PageTitle>Artworks</PageTitle>

@inject IArtworksService ArtworksService

@if(_list is null)
{
	<p>Loading...</p>
}
else
{
	<table class="table">
		<thead>
            <tr>
                <th>Image</th>
                <th>Year</th>
                <th>Title</th>
                <th>Description</th>
				<th>Author</th>
				<th>Technique</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var i in _list)
			{
				if(i is not null)
                {
                    <tr>
                        <td><img src="@i.ImageUrl" alt="Alternate Text" style="max-width: 200px"></td>
                        <td>@i.Year</td>
						<td><a href="@($"/artworks/details/{i.Id}")">@i.Title</a></td>
                        <td>@i.Description</td>
						<td>@i.Author</td>
                        <td>@i.Technique</td>
                    </tr>
				}
				else
				{
					<p>not found</p>
				}
			}
		</tbody>
	</table>
}
