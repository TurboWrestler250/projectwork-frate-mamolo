@page "/exhibitions"

<PageTitle>Exhibitions</PageTitle>

@inject IExhibitionsService ExhibitionsService

<h3>Exhibitions</h3>

@if(_list is null)
{
	<p>Loading...</p>
}
else
{
	<table class="table">
		<thead>
			<tr>
				<th>Image</th>
				<th>Start Date</th>
				<th>Finish Date</th>
				<th>Title</th>
				<th>Description</th>
				<th>Status</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var i in _list)
			{
				<ExhibitionItem Item="i" />
			}
		</tbody>
	</table>
}
