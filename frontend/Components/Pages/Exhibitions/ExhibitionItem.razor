<h3>Exhibitions</h3>

@if (Item is not null)
{
	<tr>
		<td><img src=@Item.ImageUrl alt="duomo di milano"></td>
		<td>@Item.StartDate</td>
		<td>@Item.FinishDate</td>
		<td><a href="">@Item.Title</a></td>
		<td>@Item.Description</td>
		<td>@Item.Status</td>
	</tr>
}

@code {

	[Parameter]
	public Exhibition? Item { get; set; }

}