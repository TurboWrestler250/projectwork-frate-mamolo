<h3>Exhibitions</h3>

@if (Item is not null)
{
	<tr>
		<td><img src=@Item.ImageUrl alt="duomo di milano" style="width: 100px; height: 100px; border-radius: 50%;"></td>
		<td>@Item.StartDate</td>
		<td>@Item.FinishDate</td>
		<td>@Item.Title</td>
		<td>@Item.Description</td>
		<td>@Item.Status</td>
		@* <td>
			<a href="/products/details/@Item.Id">details</a>
			<a href="@($"/products/edit/{Item.Id}")">edit</a>
		</td> *@
	</tr>
}

@code {

	[Parameter]
	public Exhibition? Item { get; set; }

}